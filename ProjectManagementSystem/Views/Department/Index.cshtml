@model IEnumerable<ProjectMannagementSystem.Models.Department>

@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<h2 style="margin-left: 20px;">Departments</h2>
<button class="btn btn-success mb-3" style="margin-left: 20px;" onclick="openAddDeptModal()">Add Department</button>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Employees</th>
            <th>Categories</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var dept in Model)
        {
            <tr id="row-@dept.DepartmentId">
                <td>@dept.Name</td>
                <td>@dept.Description</td>
                <td>
                    <a href="#" class="text-decoration-none" onclick="openEmployeesModal(@dept.DepartmentId)">
                        Employees: @dept.Employees.Count()
                    </a>
                </td>
                <td>
                    <a href="#" class="text-decoration-none" onclick="openCategoriesModal(@dept.DepartmentId)">
                        Categories: @dept.Categories.Count()
                    </a>
                </td>
                <td>
                    <button class="btn btn-sm btn-info" onclick="openEditDeptModal(@dept.DepartmentId, '@dept.Name', '@dept.Description')">
                        <i class="fas fa-edit"></i>
                    </button>
                    <button class="btn btn-sm btn-danger" onclick="openDeleteDeptModal(@dept.DepartmentId)">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Employees Modal -->
<div class="modal fade" id="employeesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Employees</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="employeesList">
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Categories Modal -->
<div class="modal fade" id="categoriesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Categories</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="categoriesList">
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
<div class="modal fade" id="deptModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="deptForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="deptModalTitle">Add/Edit Department</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="DepartmentId" name="DepartmentId" value="0" />
                    <div class="mb-3">
                        <label for="Name" class="form-label">Name</label>
                        <input type="text" class="form-control" id="Name" name="Name" required />
                    </div>
                    <div class="mb-3">
                        <label for="Description" class="form-label">Description</label>
                        <textarea class="form-control" id="Description" name="Description"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btnSaveDept" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteDeptModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle"></i> Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this department? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btnConfirmDeleteDept" class="btn btn-danger">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        let deleteDeptId = 0;

        function openAddDeptModal() {
            $('#deptModalTitle').text('Add Department');
            $('#DepartmentId').val(0);
            $('#Name').val('');
            $('#Description').val('');
            var modal = new bootstrap.Modal(document.getElementById('deptModal'));
            modal.show();
        }

        function openEditDeptModal(id, name, description) {
            $('#deptModalTitle').text('Edit Department');
            $('#DepartmentId').val(id);
            $('#Name').val(name);
            $('#Description').val(description);
            var modal = new bootstrap.Modal(document.getElementById('deptModal'));
            modal.show();
        }

        function openDeleteDeptModal(id) {
            deleteDeptId = id;
            var modalEl = document.getElementById('deleteDeptModal');
            if (!modalEl.modalInstance) {
                modalEl.modalInstance = new bootstrap.Modal(modalEl);
            }
            modalEl.modalInstance.show();
        }

        $('#btnSaveDept').click(function() {
            var formData = $('#deptForm').serialize();
            $.post('/Department/CreateOrEdit', formData, function(response) {
                if (response.success) {
                    location.reload(); 
                } else {
                    alert("Error: " + (response.message || 'Unknown'));
                }
            });
        });

        $('#btnConfirmDeleteDept').click(function() {
            $.ajax({
                url: '/Department/Delete/' + deleteDeptId,
                type: 'POST',
                success: function(response) {
                    if (response.success) {
                        $('#row-' + deleteDeptId).remove();
                        var modalEl = document.getElementById('deleteDeptModal');
                        if (modalEl.modalInstance) {
                            modalEl.modalInstance.hide();
                        }
                    } else {
                        alert('Error deleting department');
                    }
                },
                error: function() {
                    alert('Error deleting department');
                }
            });
        });
        
        function openEmployeesModal(deptId) {
            fetch('/Department/GetEmployees?deptId=' + deptId)
                .then(res => res.json())
                .then(data => {
                    let html = '<ul class="list-group">';
                    data.forEach(emp => {
                        html += `<li class="list-group-item">${emp.fullName}</li>`;
                    });
                    html += '</ul>';
                    document.getElementById('employeesList').innerHTML = html;
                    new bootstrap.Modal(document.getElementById('employeesModal')).show();
                });
        }

        function openCategoriesModal(deptId) {
            fetch('/Department/GetCategories?deptId=' + deptId)
                .then(res => res.json())
                .then(data => {
                    let html = '<ul class="list-group">';
                    data.forEach(cat => {
                        html += `<li class="list-group-item">${cat.name}</li>`;
                    });
                    html += '</ul>';
                    document.getElementById('categoriesList').innerHTML = html;
                    new bootstrap.Modal(document.getElementById('categoriesModal')).show();
                });
        }

    </script>
}
