@model IEnumerable<ProjectMannagementSystem.Models.Category>

@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<h2 style="margin-left: 10px;">Categories</h2>
<button class="btn btn-success mb-3" style="margin-left: 10px;" onclick="openAddCategoryModal()">Add Category</button>


<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Projects Count</th>
            <th>Department</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr id="row-@category.CategoryId">
                <td>@category.Name</td>
                <td>@category.Description</td>
                <td>@category.Projects.Count</td>
                <td>@(category.Department != null ? category.Department.Name : "None")</td>
                <td>
                    <button class="btn btn-primary btn-sm"
                            onclick="openEditCategoryModal(@category.CategoryId, '@category.Name', '@category.Description',@category.DepartmentId)">
                        <i class="fa fa-edit"></i>
                    </button>
                    <button class="btn btn-danger btn-sm"
                            onclick="openDeleteConfirmModal(@category.CategoryId)">
                        <i class="fa fa-trash"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Add/Edit Category Modal -->
<div class="modal fade" id="categoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="categoryModalTitle">Add Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="categoryForm">
                    <input type="hidden" id="CategoryId" name="CategoryId" value="0" />
                    <div class="mb-3">
                        <label for="Name" class="form-label">Name</label>
                        <input type="text" class="form-control" id="Name" name="Name" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label for="Description" class="form-label">Description</label>
                        <textarea class="form-control" id="Description" name="Description" maxlength="500"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="DepartmentId" class="form-label">Department</label>
                        <select id="DepartmentId" name="DepartmentId" class="form-select" required>
                            <option value="">Select Department</option>
                            @foreach (var dept in ViewBag.Departments as List<ProjectMannagementSystem.Models.Department>)
                            {
                                <option value="@dept.DepartmentId">@dept.Name</option>
                            }
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSaveCategory">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="deleteConfirmText">Are you sure you want to delete this category?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger btn-sm" id="btnConfirmDelete">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function openAddCategoryModal() {
            $('#categoryModalTitle').text('Add Category');
            $('#CategoryId').val(0);
            $('#Name').val('');
            $('#Description').val('');
            $('#DepartmentId').val('').trigger('change');
            var modal = new bootstrap.Modal(document.getElementById('categoryModal'));
            modal.show();
        }

        function openEditCategoryModal(id, name, description, departmentId) {
            $('#categoryModalTitle').text('Edit Category');
            $('#CategoryId').val(id);
            $('#Name').val(name);
            $('#Description').val(description);

            if (departmentId) {
                $('#DepartmentId').val(departmentId.toString());
            } else {
                $('#DepartmentId').val(""); 
            }

            var modal = new bootstrap.Modal(document.getElementById('categoryModal'));
            modal.show();
        }



        let deleteCategoryId = 0;

        function openDeleteConfirmModal(id) {
            deleteCategoryId = id;
            var modalEl = document.getElementById('deleteConfirmModal');
            if (!modalEl.modalInstance) {
                modalEl.modalInstance = new bootstrap.Modal(modalEl);
            }
            modalEl.modalInstance.show();
        }


        $('#btnConfirmDelete').click(function() {
            $.ajax({
                url: '/Category/Delete/' + deleteCategoryId,
                type: 'POST',
                success: function(response) {
                    if (response.success) {
                        $('#row-' + deleteCategoryId).remove();
                        showToast('Category deleted successfully', 'success');
                    } else {
                        showToast('Error deleting category', 'danger');
                    }
                },
                error: function() {
                    showToast('Error deleting category', 'danger');
                }
            });

            var modalEl = document.getElementById('deleteConfirmModal');
            if (modalEl.modalInstance) {
                modalEl.modalInstance.hide();
            }
        });

        $('#btnSaveCategory').click(function() {
            var formData = $('#categoryForm').serialize();
            $.post('/Category/Save', formData, function(response) {
                if (response.success) {
                    location.reload(); 
                } else {
                    alert("Errors: " + response.errors.join(', '));
                }
            });
        });

    </script>
}
