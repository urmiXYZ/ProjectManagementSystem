<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] ProjectSpere - Project Management System</title>
    <script type="importmap"></script>

    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet" />

    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="~/Auth/plugins/fontawesome-free/css/all.min.css">
    <!-- IonIcons -->
    <link rel="stylesheet" href="https://code.ionicframework.com/ionicons/2.0.1/css/ionicons.min.css">
    <!-- Theme style -->
    <link rel="stylesheet" href="~/Auth/dist/css/adminlte.min.css">
</head>



<body class="hold-transition sidebar-mini">
    <div class="wrapper">
        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <!-- Left navbar links -->
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
            </ul>

            <!-- Right navbar links -->
            <ul class="navbar-nav ml-auto">
                <!-- ✅ forces right alignment -->
                @inject UserManager<User> UserManager

                @if (User.Identity.IsAuthenticated)
                {
                    var currentUser = await UserManager.GetUserAsync(User);
                    var firstName = currentUser?.FullName?.Split(' ')[0];
                    var pictureUrl = string.IsNullOrEmpty(currentUser?.PicturePath)
                    ? "/images/default-avatar.png"
                    : currentUser.PicturePath;

                    <li class="nav-item d-flex align-items-center">
                        <img id="navProfileImage"
                             src="@pictureUrl"
                             alt="Profile"
                             style="width:32px; height:32px; border-radius:50%; margin-right:8px;" />

                        <span class="nav-link text-dark fw-bold" style="padding:0;">
                            Hello, @firstName!
                        </span>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-bold" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                    </li>
                }
            </ul>
        </nav>


        <!-- /.navbar -->
        <!-- Main Sidebar Container -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <!-- Brand Logo -->
            <a href="~/Auth/dist/img/Logo.png" class="brand-link">
                <img src="~/Auth/dist/img/Logo.png" alt="Logo" class="brand-image elevation-3" style="opacity: .8">
                <span class="brand-text font-weight-light">ProjectSphere</span>
            </a>

            <!-- Sidebar -->
            <div class="sidebar">
               

                <!-- Sidebar Menu -->
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        <!-- Add icons to the links using the .nav-icon class
                             with font-awesome or any other icon font library -->
                        <li class="nav-item menu-open">
                            <a href="/AuthUser/Dashboard" class="nav-link active">
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p>
                                    Dashboard
                                </p>
                            </a>

                        <li class="nav-header">Pages</li>
                        <li class="nav-item">
                            <a href="#" class="nav-link text-warning">
                                    @{
                                        string role = User.IsInRole("SuperAdmin") ? "Super Admin"
                                        : User.IsInRole("Admin") ? "Admin"
                                        : User.IsInRole("Employee") ? "Employee"
                                        : "";
                                    }
                                <span>@role</span>
                            </a>
                        </li>



                        <li class="nav-item">
                            <a href="/Home/Index" class="nav-link">
                                <i class="nav-icon fas fa-circle"></i>
                                <p>Home</p>
                            </a>
                            </li>
                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-circle"></i>
                                <p>Project<i class="right fas fa-angle-left"></i></p>
                            </a>
                            <ul class="nav nav-treeview">
                                    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                                    {
                                    <li class="nav-item">
                                        <a href="/Project/Index" class="nav-link">
                                            <i class="far fa-circle nav-icon"></i>
                                            <p>Project List</p>
                                        </a>
                                    </li>

                                    }
                                <li class="nav-item">
                                    <a href="/AssignProject/Index" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>
                                            Assigned Project List
                                            <i class="right fas fa-angle-left"></i>
                                        </p>
                                    </a>

                                </li>

                            </ul>
                        </li>
                            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                            {
                            <li class="nav-item">
                                <a href="#" class="nav-link">
                                    <i class="nav-icon fas fa-circle"></i>
                                    <p>
                                        User<i class="right fas fa-angle-left"></i>
                                    </p>
                                </a>
                                <ul class="nav nav-treeview">
                                    <li class="nav-item">
                                        <a href="/User/Index" class="nav-link">
                                            <i class="far fa-circle nav-icon"></i>
                                            <p>User List</p>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            }
                            @if (User.IsInRole("SuperAdmin"))
                            {
                            <li class="nav-item">
                                <a href="#" class="nav-link">
                                    <i class="nav-icon fas fa-circle"></i>
                                    <p>
                                        Role<i class="right fas fa-angle-left"></i>
                                    </p>
                                </a>
                                <ul class="nav nav-treeview">
                                    <li class="nav-item">
                                        <a href="/Role/Index" class="nav-link">
                                            <i class="far fa-circle nav-icon"></i>
                                            <p>Role List</p>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            }


                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-circle"></i>
                                <p>
                                    Profile
                                    <i class="right fas fa-angle-left"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a href="/User/Profile" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>My Profile</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <form class="d-inline" asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="btn btn-link nav-link text-White">Logout</button>
                                    </form>
                                    <i class="right fas fa-angle-left"></i>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </nav>
                <!-- /.sidebar-menu -->
            </div>
            <!-- /.sidebar -->
        </aside>
        <div class="content-wrapper">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>


        <!-- Main Footer -->
        <footer class="main-footer">
            <strong>Copyright &copy; 2014-2021 <a href="https://adminlte.io">AdminLTE.io</a>.</strong>
            All rights reserved.
            <div class="float-right d-none d-sm-inline-block">
                <b>Version</b> 3.2.0
            </div>
        </footer>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- REQUIRED SCRIPTS -->
    <!-- jQuery -->
    <script src="~/Auth/plugins/jquery/jquery.min.js"></script>
    <!-- Bootstrap -->
    <script src="~/Auth/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- AdminLTE -->
    <script src="~/Auth/dist/js/adminlte.js"></script>

    <!-- OPTIONAL SCRIPTS -->
    <script src="~/Auth/plugins/chart.js/Chart.min.js"></script>
    <!-- AdminLTE for demo purposes -->
    <!-- AdminLTE dashboard demo (This is only for demo purposes) -->
    <script src="~/Auth/dist/js/pages/dashboard3.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>