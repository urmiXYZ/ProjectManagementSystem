@{
    Layout = "~/Views/Shared/_Layout.cshtml"; 
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 text-primary">Privacy Policy</h1>
        <p class="lead text-secondary">
            At ProjectSphere, we take your privacy seriously. This page outlines how we collect, use, and protect your personal information while using our project management system.
        </p>
    </div>
    <div class="row g-4">
        <div class="col-md-6">
            <h4>Information Collection</h4>
            <p>We collect only the information necessary for account creation, project management, and collaboration within the system.</p>
        </div>
        <div class="col-md-6">
            <h4>Data Usage</h4>
            <p>Your data is used exclusively to provide services within ProjectSphere, improve features, and ensure secure access to your projects.</p>
        </div>
        <div class="col-md-6">
            <h4>Data Protection</h4>
            <p>All sensitive information is encrypted and stored securely. We implement best practices to prevent unauthorized access.</p>
        </div>
        <div class="col-md-6">
            <h4>Third-Party Services</h4>
            <p>We do not share your personal information with third parties except for services essential to system functionality.</p>
        </div>
    </div>
</div>
