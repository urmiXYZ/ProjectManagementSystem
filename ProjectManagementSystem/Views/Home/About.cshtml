@{
    Layout = "~/Views/Shared/_Layout.cshtml"; 
    ViewData["Title"] = "About ProjectSphere";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 text-primary">About ProjectSphere</h1>
        <p class="lead text-secondary">
            ProjectSphere is a modern project management system designed to help teams collaborate efficiently, track tasks, and monitor project progress in real-time.
        </p>
    </div>
    <div class="row text-center g-4">
        <div class="col-md-4">
            <i class="fas fa-tasks fa-3x text-warning mb-3"></i>
            <h4>Manage Projects</h4>
            <p>Create, assign, and track your projects with ease.</p>
        </div>
        <div class="col-md-4">
            <i class="fas fa-users fa-3x text-success mb-3"></i>
            <h4>Collaborate With Teams</h4>
            <p>Communicate and work together seamlessly.</p>
        </div>
        <div class="col-md-4">
            <i class="fas fa-chart-line fa-3x text-primary mb-3"></i>
            <h4>Track Progress</h4>
            <p>Visualize project progress with charts and reports.</p>
        </div>
    </div>
</div>
